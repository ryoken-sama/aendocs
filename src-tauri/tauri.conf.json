{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEN Document Manager",
  "version": "0.2.3",
  "identifier": "com.aen.docs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AEN Document Manager",
        "width": 1200,
        "height": 800,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": ["resources/university_requirements.default.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyRDkyNEFEOTQ1REZBNEIKUldSTCtsMlVyU1RaUWdmQ2NmUE1OTXlud1RLaVRxQ1BKZU1LV1lMUWIyQjNVeUdlcnZNTGJQaXUK",
      "endpoints": ["https://github.com/ryoken-sama/aendocs/releases/latest/download/latest.json"]
    }
  }
}
